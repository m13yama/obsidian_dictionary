{
  "name": "vault-spellcheck",
  "version": "0.1.2",
  "description": "An English spellchecker for Obsidian with a vault-synced custom dictionary.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "check": "npm run test && npm run build"
  },
  "keywords": [
    "obsidian",
    "spellcheck",
    "dictionary"
  ],
  "license": "MIT",
  "dependencies": {
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@codemirror/language": "^6.11.3",
    "@types/node": "^22.15.17",
    "dictionary-en": "^4.0.0",
    "esbuild": "^0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
